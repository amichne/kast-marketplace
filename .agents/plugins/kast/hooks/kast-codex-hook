#!/usr/bin/env python3
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

SUPPORTED_EVENTS = {"session-start", "post-tool-use"}
MIN_KAST_VERSION = (0, 17, 8)
VERSION_PATTERN = re.compile(r"^kast (\d+)\.(\d+)\.(\d+)(?:-\d+-g[0-9a-f]+)?$")


def emit(value: dict) -> None:
    print(json.dumps(value, separators=(",", ":")))


def kast_binary() -> str | None:
    override = os.environ.get("KAST_BINARY")
    if override is not None:
        path = Path(override).expanduser()
        return str(path.resolve()) if path.is_file() and os.access(path, os.X_OK) else None
    discovered = shutil.which("kast")
    if discovered:
        return discovered
    for path in (
        Path.home() / ".local/bin/kast",
        Path.home() / ".local/share/kast/current/bin/kast",
    ):
        if path.is_file() and os.access(path, os.X_OK):
            return str(path)
    return None


def kast_version(binary: str) -> tuple[int, int, int] | None:
    try:
        result = subprocess.run(
            [binary, "--version"],
            check=False,
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    match = VERSION_PATTERN.fullmatch(result.stdout.strip())
    if result.returncode or match is None:
        return None
    return tuple(map(int, match.groups()))


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in SUPPORTED_EVENTS:
        emit(
            {
                "continue": True,
                "systemMessage": "Kast hook skipped: expected session-start or post-tool-use.",
            }
        )
        return 0
    event = sys.argv[1]
    binary = kast_binary()
    if binary is None:
        emit(
            {
                "continue": True,
                "systemMessage": (
                    "Kast hook skipped: a compatible Kast CLI is unavailable. "
                    "Install the Kast release paired with this plugin, then restart "
                    "IntelliJ and Codex."
                ),
            }
        )
        return 0
    if (version := kast_version(binary)) is None or version < MIN_KAST_VERSION:
        required = ".".join(map(str, MIN_KAST_VERSION))
        emit(
            {
                "continue": True,
                "systemMessage": (
                    f"Kast hook skipped: Kast {required} or newer is required. "
                    "Install the Kast release paired with this plugin, then restart "
                    "IntelliJ and Codex."
                ),
            }
        )
        return 0
    os.execv(binary, [binary, "developer", "codex", "hook", event])


if __name__ == "__main__":
    raise SystemExit(main())
