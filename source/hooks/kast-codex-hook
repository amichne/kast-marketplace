#!/usr/bin/env python3
import json
import os
import shutil
import sys
from pathlib import Path

SUPPORTED_EVENTS = {"session-start", "post-tool-use"}


def emit(value: dict) -> None:
    print(json.dumps(value, separators=(",", ":")))


def kast_binary() -> str | None:
    override = os.environ.get("KAST_BINARY")
    if override is not None:
        path = Path(override).expanduser()
        return str(path.resolve()) if path.is_file() and os.access(path, os.X_OK) else None
    discovered = shutil.which("kast")
    if discovered:
        return discovered
    for path in (
        Path.home() / ".local/bin/kast",
        Path.home() / ".local/share/kast/current/bin/kast",
    ):
        if path.is_file() and os.access(path, os.X_OK):
            return str(path)
    return None


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in SUPPORTED_EVENTS:
        emit(
            {
                "continue": True,
                "systemMessage": "Kast hook skipped: expected session-start or post-tool-use.",
            }
        )
        return 0
    event = sys.argv[1]
    binary = kast_binary()
    if binary is None:
        emit(
            {
                "continue": True,
                "systemMessage": (
                    "Kast hook skipped: a compatible Kast CLI is unavailable. "
                    "Install the Kast release paired with this plugin, then restart "
                    "IntelliJ and Codex."
                ),
            }
        )
        return 0
    os.execv(binary, [binary, "developer", "codex", "hook", event])


if __name__ == "__main__":
    raise SystemExit(main())
