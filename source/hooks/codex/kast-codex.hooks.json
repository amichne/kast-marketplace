{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/kast-codex-hook session-start",
            "timeout": 130,
            "statusMessage": "Preparing the exact-root Kast runtime"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "hooks/kast-codex-hook post-tool-use",
            "timeout": 70,
            "statusMessage": "Checking changed Kotlin files with Kast"
          }
        ]
      }
    ]
  }
}
