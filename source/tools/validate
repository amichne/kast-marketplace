#!/usr/bin/env python3
import hashlib
import json
import os
import runpy
import subprocess
import sys
import tempfile
from pathlib import Path


root = Path(__file__).resolve().parents[2]
source = root / "source"
plugin = root / ".agents/plugins/kast"
marketplace_path = root / ".agents/plugins/marketplace.json"
lock_path = root / ".agents/plugins/marketplace-lock.json"
manifest_path = plugin / ".codex-plugin/plugin.json"
hooks_path = plugin / "hooks/kast-codex.hooks.json"
launcher = plugin / "hooks/kast-codex-hook"
source_launcher = source / "hooks/kast-codex-hook"
routing_evals_path = source / "evals/routing.json"
workflow_path = root / ".github/workflows/project.yml"
readme = root / "README.md"
required = [
    readme,
    workflow_path,
    source / "adaptable.marketplace.json",
    source / "plugins/kast/plugin.json",
    source / "hooks/kast-codex.hook.json",
    source / "hooks/codex/kast-codex.hooks.json",
    source_launcher,
    source / "skills/kast-query/SKILL.md",
    source / "skills/kast-query/agents/openai.yaml",
    source / "skills/kast-change/SKILL.md",
    source / "skills/kast-change/agents/openai.yaml",
    routing_evals_path,
    marketplace_path,
    lock_path,
    manifest_path,
    plugin / "hooks/metadata/kast-codex.hook.json",
    plugin / "skills/kast-query/SKILL.md",
    plugin / "skills/kast-query/agents/openai.yaml",
    plugin / "skills/kast-change/SKILL.md",
    plugin / "skills/kast-change/agents/openai.yaml",
    hooks_path,
    launcher,
]
missing = [str(path.relative_to(root)) for path in required if not path.is_file()]
if missing:
    raise SystemExit("missing: " + ", ".join(missing))

launcher_contract = runpy.run_path(str(source_launcher))
minimum_kast_version = launcher_contract.get("MIN_KAST_VERSION")
version_pattern = launcher_contract.get("VERSION_PATTERN")
if (
    not isinstance(minimum_kast_version, tuple)
    or len(minimum_kast_version) != 3
    or not all(isinstance(part, int) for part in minimum_kast_version)
):
    raise SystemExit("Kast launcher must declare a three-part MIN_KAST_VERSION")
minimum_kast_version_text = ".".join(map(str, minimum_kast_version))
for reported_version in (
    f"kast {minimum_kast_version_text}",
    f"kast {minimum_kast_version_text}-1-gabc123",
):
    if version_pattern is None or version_pattern.fullmatch(reported_version) is None:
        raise SystemExit(f"Kast launcher must accept its release grammar: {reported_version}")
for reported_version in (
    f"kast {minimum_kast_version_text}garbage",
    f"kast {minimum_kast_version_text}.999",
    f"kast {minimum_kast_version_text}-rc.1",
):
    if version_pattern is not None and version_pattern.fullmatch(reported_version) is not None:
        raise SystemExit(f"Kast launcher must reject malformed versions: {reported_version}")


def source_sha1(directory: Path) -> str:
    digest = hashlib.sha1()
    for path in sorted(path for path in directory.rglob("*") if path.is_file()):
        digest.update(path.relative_to(directory).as_posix().encode())
        digest.update(b"\0")
        digest.update(path.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()


marketplace = json.loads(marketplace_path.read_text())
lock = json.loads(lock_path.read_text())
manifest = json.loads(manifest_path.read_text())
hooks = json.loads(hooks_path.read_text())
source_hooks = json.loads((source / "hooks/codex/kast-codex.hooks.json").read_text())
adaptable = json.loads((source / "adaptable.marketplace.json").read_text())
composition = json.loads((source / "plugins/kast/plugin.json").read_text())
hook_primitive = json.loads((source / "hooks/kast-codex.hook.json").read_text())
projected_hook_primitive = json.loads(
    (plugin / "hooks/metadata/kast-codex.hook.json").read_text()
)
routing_evals = json.loads(routing_evals_path.read_text())

entry = adaptable["plugins"][0]
versions = {
    composition["version"],
    entry["plugin"]["version"],
    manifest["version"],
    lock["plugins"][0]["version"],
}
if lock["sourceSha"] != source_sha1(source):
    raise SystemExit("projected marketplace lock does not bind the current source tree")
if adaptable["type"] != "MARKETPLACE" or entry["name"] != "kast":
    raise SystemExit("adaptable marketplace must expose the Kast composition")
if len(versions) != 1:
    raise SystemExit(f"Kast source and projected versions differ: {sorted(versions)}")
expected_skills = ["kast-query", "kast-change"]
if [skill["name"] for skill in composition["skills"]] != expected_skills:
    raise SystemExit("Kast plugin must expose only kast-query and kast-change")
if [skill["name"] for skill in adaptable["skills"]] != expected_skills:
    raise SystemExit("Kast marketplace must expose only kast-query and kast-change")
if composition["instructions"] or adaptable["instructions"]:
    raise SystemExit("Kast routing must remain skill-owned, not a plugin instruction")
if composition["metadata"] != {"composition": "referential"}:
    raise SystemExit("Kast plugin must remain a referential composition")
expected_hook_primitive = {
    **hook_primitive,
    "path": "hooks/kast-codex.hooks.json",
}
if expected_hook_primitive != projected_hook_primitive:
    raise SystemExit("projected hook metadata must match its source primitive")
if hook_primitive["path"] != "hooks/codex/kast-codex.hooks.json":
    raise SystemExit("Kast hook primitive must point at the Codex adapter")
if marketplace["name"] != "kast" or marketplace["plugins"][0]["name"] != "kast":
    raise SystemExit("marketplace must expose kast@kast")
if (
    manifest["name"] != "kast"
    or manifest["skills"] != "./skills/"
    or manifest["hooks"] != ["./hooks/kast-codex.hooks.json"]
):
    raise SystemExit("plugin manifest must expose the Kast skills and hooks")

events = {"SessionStart": "session-start", "PostToolUse": "post-tool-use"}
if set(source_hooks["hooks"]) != set(events) or set(hooks["hooks"]) != set(events):
    raise SystemExit("plugin must expose only Rust-supported Kast hook events")
for codex_event, kast_event in events.items():
    source_command = source_hooks["hooks"][codex_event][0]["hooks"][0]["command"]
    projected_command = hooks["hooks"][codex_event][0]["hooks"][0]["command"]
    if source_command != f"hooks/kast-codex-hook {kast_event}":
        raise SystemExit(f"source {codex_event} must invoke {kast_event}")
    if projected_command != f'"$PLUGIN_ROOT/hooks/kast-codex-hook" {kast_event}':
        raise SystemExit(f"projected {codex_event} must invoke {kast_event}")

source_trees = {
    source / "skills/kast-query": plugin / "skills/kast-query",
    source / "skills/kast-change": plugin / "skills/kast-change",
}
if {
    path.name for path in (plugin / "skills").iterdir() if path.is_dir()
} != set(expected_skills):
    raise SystemExit("projected plugin must expose only kast-query and kast-change")
for source_tree, projected_tree in source_trees.items():
    source_files = {
        path.relative_to(source_tree): path
        for path in source_tree.rglob("*")
        if path.is_file()
    }
    projected_files = {
        path.relative_to(projected_tree): path
        for path in projected_tree.rglob("*")
        if path.is_file()
    }
    if set(source_files) != set(projected_files):
        raise SystemExit(f"projected skill file set differs for {source_tree.name}")
    for relative, source_file in source_files.items():
        if source_file.read_bytes() != projected_files[relative].read_bytes():
            raise SystemExit(f"projected skill is stale: {source_tree.name}/{relative}")
if source_launcher.read_bytes() != launcher.read_bytes():
    raise SystemExit("projected Kast launcher is stale")

forbidden = (
    "kast agent graphify",
    "--manifest",
    "--output-file",
    "--base-graph",
    "KAST_IDEA_APP",
    "PreToolUse",
    "open -a",
)
surface_files = {
    readme,
    source / "adaptable.marketplace.json",
    source / "plugins/kast/plugin.json",
}
for directory in (source / "skills/kast-query", source / "skills/kast-change", source / "hooks"):
    for path in directory.rglob("*"):
        if not path.is_file() or "__pycache__" in path.parts:
            continue
        surface_files.add(path)
for path in surface_files:
    text = path.read_text(errors="replace")
    lowered = text.lower()
    stale = [token for token in forbidden if token.lower() in lowered]
    if stale:
        raise SystemExit(f"stale Kast surface in {path.relative_to(root)}: {stale}")

readme_text = readme.read_text()
for command in (
    "codex plugin marketplace add amichne/kast-marketplace --ref main --json",
    "codex plugin add kast@kast --json",
):
    if command not in readme_text:
        raise SystemExit(f"README must document direct install command: {command}")
if f"`{minimum_kast_version_text}`" not in readme_text:
    raise SystemExit("README must document the launcher's minimum Kast version")
workflow_text = workflow_path.read_text()
for required_workflow_contract in (
    "./source/tools/validate",
    "MIN_KAST_VERSION",
    "gh release download",
    'kast-${tag}-linux-x64.zip',
    'KAST_BINARY="$binary" ./source/tools/validate',
    "needs: validate",
):
    if required_workflow_contract not in workflow_text:
        raise SystemExit(
            f"project workflow must retain paired runtime validation: {required_workflow_contract}"
        )
if [dependency["name"] for dependency in hook_primitive.get("dependsOn", [])] != expected_skills:
    raise SystemExit("Kast hook must depend on both visible workflows")

query_text = (source / "skills/kast-query/SKILL.md").read_text()
root_discovery = "kast --output json"
runtime_start = (
    'kast developer runtime up --workspace-root "$ROOT" '
    "--backend idea --accept-indexing"
)
runtime_ready = (
    'kast ready --workspace-root "$ROOT" --backend idea --for kotlin'
)
for skill_name in expected_skills:
    skill_text = (source / f"skills/{skill_name}/SKILL.md").read_text()
    skill_contract = " ".join(skill_text.split())
    if (
        root_discovery not in skill_contract
        or runtime_start not in skill_contract
        or runtime_ready not in skill_contract
    ):
        raise SystemExit(
            f"{skill_name} must discover exact scope and work without the optional session hook"
        )
for mutation in (
    "kast agent rename",
    "kast agent add-file",
    "kast agent add-declaration",
    "kast agent add-implementation",
    "kast agent add-statement",
    "kast agent replace-declaration",
):
    if mutation in query_text:
        raise SystemExit(f"kast-query must remain read-only: {mutation}")

expected_routing = {
    "kotlin-query": {"skills": ["kast-query"], "graphify": "forbidden"},
    "kotlin-mutation": {"skills": ["kast-change"], "graphify": "forbidden"},
    "gradle-query": {"skills": ["kast-query"], "graphify": "forbidden"},
    "gradle-mutation": {"skills": ["kast-change"], "graphify": "forbidden"},
    "kotlin-blocker": {"skills": ["kast-query"], "graphify": "forbidden"},
    "non-kotlin": {"skills": [], "graphify": "allowed"},
    "mixed": {"skills": ["kast-query"], "graphify": "non-kotlin-only"},
}
if routing_evals.get("schemaVersion") != 1 or not isinstance(
    routing_evals.get("cases"), list
):
    raise SystemExit("routing evals must use schemaVersion 1 with a cases list")
cases = {case.get("id"): case for case in routing_evals["cases"]}
if set(cases) != set(expected_routing) or len(cases) != len(routing_evals["cases"]):
    raise SystemExit("routing evals must cover the seven Kast/Graphify boundaries")
for case_id, expectation in expected_routing.items():
    case = cases[case_id]
    if not isinstance(case.get("prompt"), str) or not case["prompt"].strip():
        raise SystemExit(f"routing eval {case_id} must include a prompt")
    if case.get("expected") != expectation:
        raise SystemExit(f"routing eval {case_id} has the wrong activation contract")
expected_observations = [
    {
        "caseId": "kotlin-query",
        "date": "2026-07-28",
        "surface": "codex-exec",
        "outcome": {"selected": ["kast-query"], "excluded": ["graphify"]},
    },
    {
        "caseId": "kotlin-mutation",
        "date": "2026-07-28",
        "surface": "codex-exec",
        "outcome": {
            "selected": ["kast-change"],
            "excluded": ["graphify", "kast-query"],
        },
    },
    {
        "caseId": "non-kotlin",
        "date": "2026-07-28",
        "surface": "codex-exec",
        "outcome": {
            "selected": ["graphify"],
            "excluded": ["kast-query", "kast-change"],
        },
    },
]
if routing_evals.get("observations") != expected_observations:
    raise SystemExit("routing evals must retain the representative live routing observations")

for path in (source_launcher, launcher):
    if not os.access(path, os.X_OK):
        raise SystemExit(f"launcher is not executable: {path.relative_to(root)}")
    compile(path.read_text(), str(path), "exec")

with tempfile.TemporaryDirectory() as scratch:
    fake_kast = Path(scratch) / "kast"
    fake_kast.write_text(
        f"#!{sys.executable}\n"
        "import json, sys\n"
        "if sys.argv[1:] == ['--version']:\n"
        f"    print('kast {minimum_kast_version_text}')\n"
        "    raise SystemExit(0)\n"
        "print(json.dumps({'argv': sys.argv[1:], 'stdin': sys.stdin.read()}))\n"
    )
    fake_kast.chmod(0o755)
    environment = os.environ | {"KAST_BINARY": str(fake_kast)}
    payload = '{"cwd":"/tmp/exact-root","proof":"unchanged"}'
    for event in events.values():
        forwarded = subprocess.run(
            [launcher, event],
            input=payload,
            check=True,
            capture_output=True,
            text=True,
            env=environment,
        )
        forwarded_payload = json.loads(forwarded.stdout)
        if forwarded_payload != {
            "argv": ["developer", "codex", "hook", event],
            "stdin": payload,
        }:
            raise SystemExit(f"{event} must forward exact argv and stdin to Kast")
    rejected = subprocess.run(
        [launcher, "pre-tool-use"],
        input=payload,
        check=True,
        capture_output=True,
        text=True,
        env=environment,
    )
    rejected_payload = json.loads(rejected.stdout)
    if (
        not rejected_payload.get("continue")
        or "expected session-start or post-tool-use"
        not in rejected_payload.get("systemMessage", "")
    ):
        raise SystemExit("unknown hook events must be rejected before invoking Kast")
    for reported_version in (
        "kast 0.17.4",
        f"kast {minimum_kast_version_text}garbage",
        f"kast {minimum_kast_version_text}.999",
        f"kast {minimum_kast_version_text}-rc.1",
        "not-a-version",
    ):
        versioned_kast = Path(scratch) / reported_version.replace(" ", "-")
        versioned_kast.write_text(
            f"#!{sys.executable}\n"
            "import sys\n"
            "if sys.argv[1:] == ['--version']:\n"
            f"    print({reported_version!r})\n"
            "    raise SystemExit(0)\n"
            "raise SystemExit('event must not reach an incompatible Kast')\n"
        )
        versioned_kast.chmod(0o755)
        blocked = subprocess.run(
            [launcher, "session-start"],
            input=payload,
            check=True,
            capture_output=True,
            text=True,
            env=os.environ | {"KAST_BINARY": str(versioned_kast)},
        )
        blocked_payload = json.loads(blocked.stdout)
        if (
            not blocked_payload.get("continue")
            or minimum_kast_version_text
            not in blocked_payload.get("systemMessage", "")
        ):
            raise SystemExit("incompatible Kast versions must fail closed in the launcher")

kast_binary = os.environ.get("KAST_BINARY")
if kast_binary:
    binary = Path(kast_binary).expanduser().resolve()
    if not binary.is_file() or not os.access(binary, os.X_OK):
        raise SystemExit(f"KAST_BINARY is not executable: {binary}")

    def help_text(*arguments: str) -> str:
        result = subprocess.run(
            [binary, *arguments, "--help"],
            check=False,
            capture_output=True,
            text=True,
        )
        if result.returncode:
            raise SystemExit(f"Kast help failed for {' '.join(arguments)}")
        return result.stdout

    agent_help = help_text("agent")
    graph_help = help_text("agent", "graph")
    repository_help = help_text("agent", "repository")
    runtime_up_help = help_text("developer", "runtime", "up")
    hook_help = help_text("developer", "codex", "hook")
    if not all(command in agent_help for command in ("graph", "repository")):
        raise SystemExit("Kast agent help must expose graph and repository")
    if not all(
        operation in graph_help
        for operation in ("refresh", "summary", "nodes", "neighbors", "topology", "communities")
    ):
        raise SystemExit("Kast graph help is missing a documented native operation")
    if not all(
        recipe in graph_help
        for recipe in (
            'kast agent graph --workspace-root "$PWD" --operation summary',
            'kast agent graph --workspace-root "$PWD" --operation refresh --file-path src/main/kotlin/App.kt',
        )
    ):
        raise SystemExit("Kast graph help is missing a canonical invocation")
    if not all(
        intent in repository_help
        for intent in (
            "resolve",
            "path",
            "incoming-impact",
            "outgoing-impact",
            "architecture",
            "context-relationship",
        )
    ):
        raise SystemExit("Kast repository help is missing a documented intent")
    if (
        "session-start" not in hook_help
        or "post-tool-use" not in hook_help
        or "pre-tool-use" in hook_help
    ):
        raise SystemExit("Kast hook help differs from the projected adapter")
    if (
        "--accept-indexing" not in runtime_up_help
        or 'kast developer runtime up --workspace-root "$PWD" --backend idea --accept-indexing'
        not in runtime_up_help
    ):
        raise SystemExit("Kast runtime help is missing the canonical IDEA startup recipe")

    with tempfile.TemporaryDirectory() as scratch:
        non_gradle_root = Path(scratch) / "plain"
        non_gradle_root.mkdir()
        environment = os.environ | {
            "KAST_CONFIG_HOME": str(Path(scratch) / "config"),
            "KAST_BINARY": str(binary),
        }
        for event in events.values():
            try:
                probe = subprocess.run(
                    [launcher, event],
                    input=json.dumps({"cwd": str(non_gradle_root)}) + "\n",
                    check=False,
                    capture_output=True,
                    text=True,
                    timeout=15,
                    env=environment,
                )
            except subprocess.TimeoutExpired:
                raise SystemExit(
                    f"KAST_BINARY Codex {event} timed out outside a Gradle workspace"
                )
            try:
                probe_output = json.loads(probe.stdout)
            except json.JSONDecodeError:
                raise SystemExit(f"KAST_BINARY Codex {event} returned invalid JSON")
            if probe.returncode or probe_output != {}:
                raise SystemExit(
                    f"KAST_BINARY Codex {event} must return {{}} outside a Gradle workspace"
                )

print("Kast marketplace valid")
