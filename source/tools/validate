#!/usr/bin/env python3
import hashlib
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path


root = Path(__file__).resolve().parents[2]
source = root / "source"
plugin = root / ".agents/plugins/kast"
marketplace_path = root / ".agents/plugins/marketplace.json"
lock_path = root / ".agents/plugins/marketplace-lock.json"
manifest_path = plugin / ".codex-plugin/plugin.json"
hooks_path = plugin / "hooks/kast-codex.hooks.json"
launcher = plugin / "hooks/kast-codex-hook"
source_launcher = source / "hooks/kast-codex-hook"
readme = root / "README.md"
required = [
    readme,
    source / "adaptable.marketplace.json",
    source / "plugins/kast/plugin.json",
    source / "hooks/kast-codex.hook.json",
    source / "hooks/codex/kast-codex.hooks.json",
    source_launcher,
    source / "skills/kast-codex/SKILL.md",
    source / "skills/kast-codex/agents/openai.yaml",
    source / "skills/kast-codex/references/lifecycle.md",
    marketplace_path,
    lock_path,
    manifest_path,
    plugin / "hooks/metadata/kast-codex.hook.json",
    plugin / "skills/kast-codex/SKILL.md",
    plugin / "skills/kast-codex/agents/openai.yaml",
    plugin / "skills/kast-codex/references/lifecycle.md",
    hooks_path,
    launcher,
]
missing = [str(path.relative_to(root)) for path in required if not path.is_file()]
if missing:
    raise SystemExit("missing: " + ", ".join(missing))


def source_sha1(directory: Path) -> str:
    digest = hashlib.sha1()
    for path in sorted(path for path in directory.rglob("*") if path.is_file()):
        digest.update(path.relative_to(directory).as_posix().encode())
        digest.update(b"\0")
        digest.update(path.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()


marketplace = json.loads(marketplace_path.read_text())
lock = json.loads(lock_path.read_text())
manifest = json.loads(manifest_path.read_text())
hooks = json.loads(hooks_path.read_text())
source_hooks = json.loads((source / "hooks/codex/kast-codex.hooks.json").read_text())
adaptable = json.loads((source / "adaptable.marketplace.json").read_text())
composition = json.loads((source / "plugins/kast/plugin.json").read_text())
hook_primitive = json.loads((source / "hooks/kast-codex.hook.json").read_text())
projected_hook_primitive = json.loads(
    (plugin / "hooks/metadata/kast-codex.hook.json").read_text()
)

entry = adaptable["plugins"][0]
versions = {
    composition["version"],
    entry["plugin"]["version"],
    manifest["version"],
    lock["plugins"][0]["version"],
}
if lock["sourceSha"] != source_sha1(source):
    raise SystemExit("projected marketplace lock does not bind the current source tree")
if adaptable["type"] != "MARKETPLACE" or entry["name"] != "kast":
    raise SystemExit("adaptable marketplace must expose the Kast composition")
if len(versions) != 1:
    raise SystemExit(f"Kast source and projected versions differ: {sorted(versions)}")
if [skill["name"] for skill in composition["skills"]] != ["kast-codex"]:
    raise SystemExit("Kast plugin must expose only the native kast-codex skill")
if [skill["name"] for skill in adaptable["skills"]] != ["kast-codex"]:
    raise SystemExit("Kast marketplace must expose only the native kast-codex skill")
if composition["metadata"] != {"composition": "referential"}:
    raise SystemExit("Kast plugin must remain a referential composition")
expected_hook_primitive = {
    **hook_primitive,
    "path": "hooks/kast-codex.hooks.json",
}
if expected_hook_primitive != projected_hook_primitive:
    raise SystemExit("projected hook metadata must match its source primitive")
if hook_primitive["path"] != "hooks/codex/kast-codex.hooks.json":
    raise SystemExit("Kast hook primitive must point at the Codex adapter")
if marketplace["name"] != "kast" or marketplace["plugins"][0]["name"] != "kast":
    raise SystemExit("marketplace must expose kast@kast")
if (
    manifest["name"] != "kast"
    or manifest["skills"] != "./skills/"
    or manifest["hooks"] != ["./hooks/kast-codex.hooks.json"]
):
    raise SystemExit("plugin manifest must expose the Kast skills and hooks")

events = {"SessionStart": "session-start", "PostToolUse": "post-tool-use"}
if set(source_hooks["hooks"]) != set(events) or set(hooks["hooks"]) != set(events):
    raise SystemExit("plugin must expose only Rust-supported Kast hook events")
for codex_event, kast_event in events.items():
    source_command = source_hooks["hooks"][codex_event][0]["hooks"][0]["command"]
    projected_command = hooks["hooks"][codex_event][0]["hooks"][0]["command"]
    if source_command != f"hooks/kast-codex-hook {kast_event}":
        raise SystemExit(f"source {codex_event} must invoke {kast_event}")
    if projected_command != f'"$PLUGIN_ROOT/hooks/kast-codex-hook" {kast_event}':
        raise SystemExit(f"projected {codex_event} must invoke {kast_event}")

source_trees = {
    source / "skills/kast-codex": plugin / "skills/kast-codex",
}
if {
    path.name for path in (plugin / "skills").iterdir() if path.is_dir()
} != {"kast-codex"}:
    raise SystemExit("projected plugin must expose only the native kast-codex skill")
for source_tree, projected_tree in source_trees.items():
    source_files = {
        path.relative_to(source_tree): path
        for path in source_tree.rglob("*")
        if path.is_file()
    }
    projected_files = {
        path.relative_to(projected_tree): path
        for path in projected_tree.rglob("*")
        if path.is_file()
    }
    if set(source_files) != set(projected_files):
        raise SystemExit(f"projected skill file set differs for {source_tree.name}")
    for relative, source_file in source_files.items():
        if source_file.read_bytes() != projected_files[relative].read_bytes():
            raise SystemExit(f"projected skill is stale: {source_tree.name}/{relative}")
if source_launcher.read_bytes() != launcher.read_bytes():
    raise SystemExit("projected Kast launcher is stale")

forbidden = (
    "graphify",
    "kast agent graphify",
    "--manifest",
    "--output-file",
    "--base-graph",
    "KAST_IDEA_APP",
    "PreToolUse",
    "open -a",
)
surface_files = {
    readme,
    source / "adaptable.marketplace.json",
    source / "plugins/kast/plugin.json",
}
for directory in (source / "skills/kast-codex", source / "hooks"):
    for path in directory.rglob("*"):
        if not path.is_file() or "__pycache__" in path.parts:
            continue
        surface_files.add(path)
for path in surface_files:
    text = path.read_text(errors="replace")
    lowered = text.lower()
    stale = [token for token in forbidden if token.lower() in lowered]
    if stale:
        raise SystemExit(f"stale Kast surface in {path.relative_to(root)}: {stale}")

readme_text = readme.read_text()
for command in (
    "codex plugin marketplace add amichne/kast-marketplace --ref main --json",
    "codex plugin add kast@kast --json",
):
    if command not in readme_text:
        raise SystemExit(f"README must document direct install command: {command}")

for path in (source_launcher, launcher):
    if not os.access(path, os.X_OK):
        raise SystemExit(f"launcher is not executable: {path.relative_to(root)}")
    compile(path.read_text(), str(path), "exec")

with tempfile.TemporaryDirectory() as scratch:
    fake_kast = Path(scratch) / "kast"
    fake_kast.write_text(
        f"#!{sys.executable}\n"
        "import json, sys\n"
        "print(json.dumps({'argv': sys.argv[1:], 'stdin': sys.stdin.read()}))\n"
    )
    fake_kast.chmod(0o755)
    environment = os.environ | {"KAST_BINARY": str(fake_kast)}
    payload = '{"cwd":"/tmp/exact-root","proof":"unchanged"}'
    for event in events.values():
        forwarded = subprocess.run(
            [launcher, event],
            input=payload,
            check=True,
            capture_output=True,
            text=True,
            env=environment,
        )
        forwarded_payload = json.loads(forwarded.stdout)
        if forwarded_payload != {
            "argv": ["developer", "codex", "hook", event],
            "stdin": payload,
        }:
            raise SystemExit(f"{event} must forward exact argv and stdin to Kast")
    rejected = subprocess.run(
        [launcher, "pre-tool-use"],
        input=payload,
        check=True,
        capture_output=True,
        text=True,
        env=environment,
    )
    rejected_payload = json.loads(rejected.stdout)
    if (
        not rejected_payload.get("continue")
        or "expected session-start or post-tool-use"
        not in rejected_payload.get("systemMessage", "")
    ):
        raise SystemExit("unknown hook events must be rejected before invoking Kast")

kast_binary = os.environ.get("KAST_BINARY")
if kast_binary:
    binary = Path(kast_binary).expanduser().resolve()
    if not binary.is_file() or not os.access(binary, os.X_OK):
        raise SystemExit(f"KAST_BINARY is not executable: {binary}")

    def help_text(*arguments: str) -> str:
        result = subprocess.run(
            [binary, *arguments, "--help"],
            check=False,
            capture_output=True,
            text=True,
        )
        if result.returncode:
            raise SystemExit(f"Kast help failed for {' '.join(arguments)}")
        return result.stdout

    agent_help = help_text("agent")
    graph_help = help_text("agent", "graph")
    repository_help = help_text("agent", "repository")
    hook_help = help_text("developer", "codex", "hook")
    if not all(command in agent_help for command in ("graph", "repository")):
        raise SystemExit("Kast agent help must expose graph and repository")
    if not all(
        operation in graph_help
        for operation in ("refresh", "summary", "nodes", "neighbors", "topology", "communities")
    ):
        raise SystemExit("Kast graph help is missing a documented native operation")
    if not all(
        intent in repository_help
        for intent in (
            "resolve",
            "path",
            "incoming-impact",
            "outgoing-impact",
            "architecture",
            "context-relationship",
        )
    ):
        raise SystemExit("Kast repository help is missing a documented intent")
    if (
        "session-start" not in hook_help
        or "post-tool-use" not in hook_help
        or "pre-tool-use" in hook_help
    ):
        raise SystemExit("Kast hook help differs from the projected adapter")

print("Kast marketplace valid")
